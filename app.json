{
  "name": "com.kikx.appstore",
  "title": "AppStore",
  "version": "0.1.0",
  "author": "luvbyte",
  "description": "kikx app store",
  "kikx_version": "0.4.4",

  "include": ["public", "www"],

  "iframe": {
    "sandbox": ["allow-scripts"]
  },

  "system": {
    "access": ["kpm", "invoke", "alerts"]
  },

  "services": ["kv"],

  "share": {
    "message": "Install App",
    "types": ["file"],
    "accept": [".kikx"]
  },

  "theme": "dark",
  "sudo": true
}
